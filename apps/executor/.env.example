# nexID tokenization executor
# Deploy this as a separate backend service when API should not hold the minter key.
PORT=3010
TOKENIZATION_EXECUTOR_SECRET=replace-with-long-random-secret
# Dedicated executor DB role: table SELECT plus UPDATE(meta) only. This is the
# durable one-shot Polygon mint authorization boundary; /mint fails without it.
DATABASE_URL=postgresql://nexid_executor:...@.../nexid?sslmode=require
# Comma-separated deployment scope. When omitted, both legacy routes remain
# enabled for compatibility. Production deployments should declare only the
# chains they are configured to serve: polygon, iota, or polygon,iota.
EXECUTOR_CAPABILITIES=polygon

# Amoy pilot signer. Prefer kms_wrapped: ciphertext is configuration, while
# plaintext exists only ephemerally in the isolated executor process.
NEXID_KMS_ENVIRONMENT=staging
KMS_DECRYPT_TIMEOUT_MS=10000
EXECUTOR_SIGNER_MODE=kms_wrapped
POLYGON_KMS_WRAP_KEY_RESOURCE=projects/nexid-security-staging/locations/us-east1/keyRings/nexid-staging/cryptoKeys/polygon-wallet-wrap-pilot
POLYGON_KMS_WRAPPED_PRIVATE_KEY=
POLYGON_KMS_PUBLISHER_ADDRESS=0x...
# Non-exportable remote KMS/HSM signing remains supported with mode=kms.
POLYGON_KMS_SIGNER_URL=
POLYGON_KMS_SIGNER_ALLOWED_HOSTS=
POLYGON_KMS_KEY_ID=
POLYGON_KMS_SIGNER_TOKEN=
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-key
POLYGON_EXPECTED_CHAIN_ID=80002
# Development-only fallback. Never configure this in the deployed executor.
POLYGON_MINTER_PRIVATE_KEY=
POLYGON_MINTER_ADDRESS=0x...
POLYGON_CONTRACT_ADDRESS=0x...

# Optional: set true only when you want /health to hit the chain.
EXECUTOR_HEALTH_LIVE=false

# IOTA Evidence Anchor V2. Keep this signer outside the public Next.js API.
IOTA_PROOF_EXECUTOR_SECRET=replace-with-a-different-long-random-secret
IOTA_EVM_RPC_URL=https://json-rpc.evm.testnet.iota.cafe
# Pilot custody: a separate KMS envelope key for the IOTA wallet.
IOTA_EXECUTOR_SIGNER_MODE=kms_wrapped
IOTA_KMS_WRAP_KEY_RESOURCE=projects/nexid-security-staging/locations/us-east1/keyRings/nexid-staging/cryptoKeys/iota-wallet-wrap-pilot
IOTA_KMS_WRAPPED_PRIVATE_KEY=
IOTA_KMS_PUBLISHER_ADDRESS=0x...
# Non-exportable remote KMS/HSM signing remains supported with mode=kms.
IOTA_KMS_SIGNER_URL=
IOTA_KMS_SIGNER_ALLOWED_HOSTS=
IOTA_KMS_KEY_ID=
IOTA_KMS_SIGNER_TOKEN=
IOTA_IDEMPOTENCY_PROCESSING_TTL_SECONDS=300
IOTA_EVM_EXPECTED_CHAIN_ID=1076
IOTA_EVM_ANCHOR_CONTRACT_V2=0x...
# Development-only fallback.
IOTA_EVM_PRIVATE_KEY=
