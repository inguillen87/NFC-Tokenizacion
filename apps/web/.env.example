NEXT_PUBLIC_API_URL=http://localhost:3003
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://nexid.lat

# Server-only, explicit authoritative API origin for the GS1 resolver registry.
# Required before enabling /01 and /id/01 routes in production; no implicit
# localhost or production fallback is used. Use HTTPS in production.
NEXID_GS1_REGISTRY_API_URL=http://localhost:3003

# Optional but recommended for Meta/Facebook link previews.
# Use the real Meta App ID for nexID; do not use a placeholder in production.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Trust maps: landing, demo lab, portal and public map storytelling.
# For demos this fallback avoids paid Google/Mapbox keys. In production, point
# to self-hosted raster tiles or keep the PMTiles URL ready for vector hosting.
NEXT_PUBLIC_NEXID_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_NEXID_DARK_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Optional operator-controlled raster override. Leave unset for OpenFreeMap vector styles.
# NEXT_PUBLIC_NEXID_RASTER_TILE_TEMPLATE=https://maps.example.com/{z}/{x}/{y}.png
NEXT_PUBLIC_NEXID_PMTILES_URL=
NEXT_PUBLIC_NEXID_MAP_ATTRIBUTION=OpenFreeMap © OpenMapTiles · Data from OpenStreetMap

# Local development only. Public production routes stay on deterministic
# fallbacks until nexID adds distributed quota plus signed/session authorization.
# Never enable this in Vercel Production.
NEXID_LOCAL_PROVIDER_CALLS_ENABLED=false
