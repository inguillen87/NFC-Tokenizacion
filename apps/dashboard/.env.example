# Enterprise map style URL hosted on your own infrastructure
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=

# Trust maps: shared premium map renderer. For production, replace the fallback
# with self-hosted raster tiles or a PMTiles asset served from your CDN/storage.
NEXT_PUBLIC_NEXID_RASTER_TILE_TEMPLATE=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
NEXT_PUBLIC_NEXID_PMTILES_URL=
NEXT_PUBLIC_NEXID_MAP_ATTRIBUTION=CARTO / OpenStreetMap

# Demo/operator access presets (prefer server-only variables)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=
RESELLER_EMAIL=
RESELLER_PASSWORD=
GENERIC_DEMO_EMAIL=
GENERIC_DEMO_PASSWORD=

# Legacy compatibility (optional)
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=
NEXT_PUBLIC_SUPER_ADMIN_PASSWORD=
NEXT_PUBLIC_TENANT_ADMIN_EMAIL=
NEXT_PUBLIC_TENANT_ADMIN_PASSWORD=
NEXT_PUBLIC_RESELLER_EMAIL=
NEXT_PUBLIC_RESELLER_PASSWORD=
NEXT_PUBLIC_GENERIC_DEMO_EMAIL=
NEXT_PUBLIC_GENERIC_DEMO_PASSWORD=

# Login routing and demo fallback controls
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=
DASHBOARD_ALLOW_DEMO_LOGIN=false
DASHBOARD_DEMO_MODE=false

# Clerk OAuth for B2B admin CRM. Keep secrets only in .env.local or Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_API_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
DASHBOARD_CLERK_AUTHORIZED_PARTIES=https://app.nexid.lat

# Demo/prod governance for admin proxy
DEMO_MODE=false
DEMO_FALLBACK_ALLOWED=false
REQUIRE_SCOPED_ADMIN_AUTH=true
