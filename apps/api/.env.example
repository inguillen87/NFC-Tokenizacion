DATABASE_URL=
ADMIN_API_KEY=
KMS_MASTER_KEY_HEX=
OPENAI_API_KEY=
NEXT_PUBLIC_PRODUCT_NAME=nexID
NEXT_PUBLIC_PARENT_BRAND=Inmovar Latam SAS
NEXT_PUBLIC_APP_URL=https://app.nexid.lat

NEXT_PUBLIC_WEB_URL=https://nexid.lat
NEXT_PUBLIC_API_URL=https://api.nexid.lat
NEXT_PUBLIC_SHORT_NAME=nexID

# Distributed realtime channel (Postgres NOTIFY/LISTEN)
REALTIME_MODE=postgres
REALTIME_PG_CHANNEL=nexid_events

# Dashboard auth presets (server-side)
SUPER_ADMIN_EMAIL=super-admin@example.com
SUPER_ADMIN_PASSWORD=
TENANT_ADMIN_EMAIL=tenant-admin@example.com
TENANT_ADMIN_PASSWORD=
GENERIC_DEMO_EMAIL=viewer@example.com
GENERIC_DEMO_PASSWORD=
DASHBOARD_ALLOW_DEMO_LOGIN=false

DEMO_MODE=false
DEMO_FALLBACK_ALLOWED=false
REQUIRE_SCOPED_ADMIN_AUTH=true
DEMO_TENANT_SLUG=demobodega
DEMO_TENANT_NAME=Demo Bodega
ENABLE_ADMIN_SELF_REGISTRATION=false
DEV_EXPOSE_RESET_TOKEN=false
DEV_EXPOSE_ACTIVATION_LINK=false
ADMIN_INVITE_TTL_MINUTES=4320

CONSUMER_AUTH_MODE=demo
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER_API_KEY=
RESEND_API_KEY=
CONSUMER_AUTH_FROM_EMAIL=
CONSUMER_AUTH_REPLY_TO_EMAIL=
CONSUMER_PHONE_OTP_CHANNEL=sms

# SMTP Credentials (optional, e.g. Namecheap Private Email: mail.privateemail.com)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Clerk sync for B2B admin identities. Consumer auth stays OTP/WhatsApp unless
# a separate B2C identity provider is explicitly added.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DASHBOARD_CLERK_SUPERADMIN_EMAIL_ALLOWLIST=guillen.marce@gmail.com

# Trust maps: post-tap mobile passport and public proof pages.
# Use a free raster fallback for demos, or point this to your own tile server.
NEXID_RASTER_TILE_TEMPLATE=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
NEXID_PMTILES_URL=
NEXID_MAP_ATTRIBUTION=CARTO / OpenStreetMap

# Polygon Amoy: ownership certificates, warranty and transferable claims.
# Current Polygon docs list third-party Amoy faucets; QuickNode/Alchemy are the practical options.
TOKENIZATION_MODE=off
TOKENIZATION_USE_LOCAL_MINTER=false
TOKENIZATION_UID_SALT=
TOKENIZATION_METADATA_CID_PREFIX=ipfs://
POLYGON_RPC_URL=https://polygon-amoy.drpc.org
POLYGON_DEPLOY_OWNER=
POLYGON_MINTER_ADDRESS=
POLYGON_MINTER_PRIVATE_KEY=
POLYGON_CONTRACT_ADDRESS=
POLYGON_DEFAULT_RECIPIENT=

# IOTA EVM Testnet: public hash-only proof anchors.
# Testnets can reset; use this for sales/technical demos, not legal production evidence.
IOTA_PROVIDER_MODE=disabled
IOTA_EVM_RPC_URL=https://json-rpc.evm.testnet.iota.cafe
IOTA_EVM_PRIVATE_KEY=
IOTA_EVM_ANCHOR_CONTRACT=
IOTA_EXPLORER_BASE_URL=https://explorer.evm.testnet.iota.cafe
PUBLIC_PROOF_DEMO_IOTA_TX_HASH=
PUBLIC_PROOF_DEMO_IOTA_TX_HASH_SECURE_DELIVERY=
PUBLIC_PROOF_DEMO_IOTA_TX_HASH_PHARMA_COLD_CHAIN=
PUBLIC_PROOF_DEMO_IOTA_TX_HASH_AGRO_STEWARDSHIP=
PUBLIC_PROOF_RECEIPT_IOTA_TX_HASH=
PUBLIC_PROOF_RECEIPT_IOTA_TX_HASH_SECURE_DELIVERY=
PUBLIC_PROOF_RECEIPT_IOTA_TX_HASH_PHARMA_COLD_CHAIN=
PUBLIC_PROOF_RECEIPT_IOTA_TX_HASH_AGRO_STEWARDSHIP=
PUBLIC_PROOF_DEMO_POLYGON_TX_HASH=
PUBLIC_PROOF_DEMO_POLYGON_TOKEN_ID=
