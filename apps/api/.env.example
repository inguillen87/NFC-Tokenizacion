DATABASE_URL=
NEXID_RUNTIME_DB_ROLE=
# Production API fails closed unless this migration exists in schema_migrations.
# Request handlers never execute CREATE/ALTER/DROP in production.
NEXID_REQUIRED_SCHEMA_MIGRATION=20260802320000_0097_sun_demo_replay_isolation.sql
# Optional comma-separated additive release gates. The compiled critical set
# 0057-0096 is always required and cannot be weakened through environment vars.
NEXID_REQUIRED_SCHEMA_MIGRATIONS=
# Legacy signing-material compatibility only. Leave unset in normal operation.
# It is never admin authentication; the two explicit legacy fallback gates below
# must also be true before certificate/SUN verification will consider it.
ADMIN_API_KEY=
KMS_MASTER_KEY_HEX=
# Legacy name: this is a raw Vercel/application secret used for pilot NFC
# AES-256-GCM envelope encryption. It is NOT managed KMS or HSM custody.
# New envelopes record this version in authenticated AAD. During rotation keep
# the prior key temporarily as NFC_ENVELOPE_KEK_<OLD_VERSION>_HEX for dual-read.
NFC_ENVELOPE_KEK_VERSION=vercel-env-v1
# Legacy envelopes have no embedded version. Keep this pinned to the KEK that
# created them until every legacy row/sample has been re-enveloped and audited.
NFC_LEGACY_ENVELOPE_KEK_VERSION=vercel-env-v1
# Example only for a previous version named vercel-env-v0:
# NFC_ENVELOPE_KEK_VERCEL_ENV_V0_HEX=
OPENAI_API_KEY=
NEXT_PUBLIC_PRODUCT_NAME=nexID
NEXT_PUBLIC_PARENT_BRAND=Inmovar Latam SAS
NEXT_PUBLIC_APP_URL=https://app.nexid.lat

NEXT_PUBLIC_WEB_URL=https://nexid.lat
NEXT_PUBLIC_API_URL=https://api.nexid.lat
NEXT_PUBLIC_SHORT_NAME=nexID
# Exact additional browser origins allowed to perform cookie-authenticated
# consumer mutations. Keep empty unless a reviewed portal/preview needs access.
CONSUMER_MUTATION_ALLOWED_ORIGINS=
# Origin permanently encoded into newly generated physical supplier tags. It
# must be HTTPS and either nexid.lat/www.nexid.lat or explicitly listed in the
# comma-separated allowlist. Request Host/X-Forwarded-Host is never trusted.
NEXID_PUBLIC_TAG_ORIGIN=https://nexid.lat
NEXID_PUBLIC_TAG_ALLOWED_ORIGINS=https://nexid.lat

# Cloudflare-to-Vercel origin authentication. Roll out in two phases: provision
# the same high-entropy secret in Vercel and a Cloudflare request-header
# overwrite rule first, then enable enforcement. Never expose either secret in
# NEXT_PUBLIC_* variables or browser code.
NEXID_EDGE_ORIGIN_ENFORCED=false
NEXID_EDGE_ORIGIN_SECRET=
# Temporary previous credential for zero-downtime rotation only; remove it as
# soon as Cloudflare is confirmed to send the new current credential.
NEXID_EDGE_ORIGIN_SECRET_PREVIOUS=
# Optional exact, comma-separated custom hosts protected outside Vercel
# production. api.nexid.lat is protected by default when enforcement is on.
NEXID_EDGE_ORIGIN_PROTECTED_HOSTS=

# Distributed realtime transport. Production requires this explicit value,
# rejects `memory`, and accepts `postgres` only with the pilot gate below.
# Use `upstash` for horizontally scaled production push.
REALTIME_MODE=upstash

# Upstash Realtime (Redis Streams + Pub/Sub over HTTP/SSE). Both credentials are
# server-only and must never use NEXT_PUBLIC_* names. Events are stored on an
# isolated tenant channel plus an explicit Super Admin aggregate channel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Mandatory namespace. Its final segment must match VERCEL_ENV (or the local
# REALTIME_UPSTASH_ENVIRONMENT/NODE_ENV fallback) to prevent cross-environment traffic.
REALTIME_UPSTASH_ENVIRONMENT=development
REALTIME_UPSTASH_CHANNEL_PREFIX=nexid:rt:v1:development
# Per-channel replay is bounded twice: stream length plus expiry. Valid ranges
# are capped in code even if an environment value is accidentally excessive.
REALTIME_UPSTASH_HISTORY_MAX_LENGTH=500
REALTIME_UPSTASH_HISTORY_TTL_SECONDS=900
REALTIME_UPSTASH_REPLAY_LIMIT=200
REALTIME_UPSTASH_REPLAY_WINDOW_SECONDS=300
REALTIME_UPSTASH_HISTORY_READ_TIMEOUT_MS=5000

# PostgreSQL pilot/fallback only. Production ignores REALTIME_MODE=postgres
# unless this deliberate acknowledgement is exactly true. Keep false for
# Upstash production. LISTEN also requires DATABASE_URL_UNPOOLED or
# POSTGRES_URL_NON_POOLING; pg_notify may use the regular pooled DATABASE_URL.
REALTIME_POSTGRES_PILOT_ENABLED=false
REALTIME_PG_CHANNEL=nexid_events

# Dashboard auth presets (server-side)
SUPER_ADMIN_EMAIL=super-admin@example.com
SUPER_ADMIN_PASSWORD=
TENANT_ADMIN_EMAIL=tenant-admin@example.com
TENANT_ADMIN_PASSWORD=
GENERIC_DEMO_EMAIL=viewer@example.com
GENERIC_DEMO_PASSWORD=
DASHBOARD_ALLOW_DEMO_LOGIN=false

# Distributed admin-login credential-stuffing guard (PostgreSQL-backed).
# Production is always fail-closed. Generate a dedicated random secret with at
# least 32 characters; do not reuse a password, API key or public value.
LOGIN_RATE_LIMIT_PEPPER=
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_SUBJECT_SOURCE_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_SOURCE_MAX_ATTEMPTS=100
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
LOGIN_RATE_LIMIT_RETENTION_SECONDS=604800
LOGIN_RATE_LIMIT_FAIL_CLOSED=true

# HMAC pepper for durable SUN/NFC, claim-PIN, and consumer-auth bucket keys.
# Required in production, at least 32 random characters, and distinct from the
# login pepper, KMS keys, API tokens, and all NEXT_PUBLIC_* values.
RATE_LIMIT_KEY_PEPPER=

DEMO_MODE=false
DEMO_FALLBACK_ALLOWED=false
REQUIRE_SCOPED_ADMIN_AUTH=true
# Superadmin-only issuance gate for offline verifier devices and bundles.
# Keep false until the tenant, device and operational rollout has been approved.
OFFLINE_VERIFIER_BUNDLES_ENABLED=false
DEMO_TENANT_SLUG=demobodega
DEMO_TENANT_NAME=Demo Bodega
PUBLIC_DEMO_TENANT_SLUG=demobodega
PUBLIC_DEMO_SHARE_SECRET=
# Stable HMAC key for capability URLs such as /certificado/:eventId?share=...
# Keep it distinct from SUN, ADMIN_API_KEY, KMS/envelope and webhook keys.
PUBLIC_CERTIFICATE_SIGNING_SECRET=
# Prior certificate key accepted during an audited rotation overlap.
PUBLIC_CERTIFICATE_SIGNING_SECRET_PREVIOUS=
# Emergency migration only. When true, old SUN/demo/admin material may verify
# historical v1 links. Set the dedicated current key first, then disable this.
PUBLIC_CERTIFICATE_ALLOW_LEGACY_SECRET_FALLBACK=false
# Offline Level 4 uses an independent asymmetric ES256 key pair. The private
# JWK remains server-only; the JWKS contains public verify keys only and may
# retain prior public keys during rotation. This is software key custody unless
# the deployment separately proves a managed KMS/HSM-backed signer.
OFFLINE_PUBLIC_CERTIFICATE_PRIVATE_JWK=
OFFLINE_PUBLIC_CERTIFICATE_JWKS=
OFFLINE_PUBLIC_CERTIFICATE_ISSUER=https://api.nexid.lat
OFFLINE_PUBLIC_CERTIFICATE_TTL_SECONDS=604800
# Short-lived SUN-to-commercial-action capability key. This is application
# HMAC custody, not NFC key custody and not KMS/HSM. Production requires at
# least 32 bytes of dedicated random material.
SUN_HANDOFF_SECRET=
SUN_HANDOFF_SECRET_PREVIOUS=
# Emergency migration only; never a steady-state production configuration.
SUN_HANDOFF_ALLOW_LEGACY_SECRET_FALLBACK=false
ENABLE_ADMIN_SELF_REGISTRATION=false
DEV_EXPOSE_RESET_TOKEN=false
DEV_EXPOSE_ACTIVATION_LINK=false
ADMIN_INVITE_TTL_MINUTES=4320

# Smart selects the configured email/SMS/WhatsApp provider and never enables a demo bypass.
CONSUMER_AUTH_MODE=smart
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER_API_KEY=
RESEND_API_KEY=
CONSUMER_AUTH_FROM_EMAIL=
CONSUMER_AUTH_REPLY_TO_EMAIL=
CONSUMER_PHONE_OTP_CHANNEL=sms

# Durable tenant webhook outbox. Invoke POST /internal/webhooks/worker from a
# private scheduler. Google Cloud Scheduler should use a Google-signed OIDC ID
# token restricted to this exact service-account email and audience. The shared
# secret is a recovery fallback only; never expose it to browser code.
INTERNAL_WEBHOOK_WORKER_KEY=
WEBHOOK_SCHEDULER_OIDC_SERVICE_ACCOUNT_EMAIL=
WEBHOOK_SCHEDULER_OIDC_AUDIENCE=https://api.nexid.lat/internal/webhooks/worker
# Dedicated 32-byte application-layer encryption key, encoded as exactly 64
# hexadecimal characters. It protects webhook signing secrets at rest and must
# never reuse KMS_MASTER_KEY_HEX or any public/client-side value.
WEBHOOK_SIGNING_MASTER_KEY_HEX=
# Temporary migration switch. Production rejects legacy plaintext by default.
# Set true only for the documented migration window, then restore false.
WEBHOOK_SIGNING_ALLOW_LEGACY_PLAINTEXT=false
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_DNS_TIMEOUT_MS=3000
WEBHOOK_REQUEST_TIMEOUT_MS=10000
WEBHOOK_MAX_RESPONSE_BYTES=65536

# Dedicated active 32-byte key (64 hexadecimal characters) for SDK idempotency
# request HMACs and encrypted response replay. Never reuse NFC/webhook keys.
SDK_IDEMPOTENCY_MASTER_KEY_HEX=
# Optional stable identifier for the active key. If omitted, the API derives a
# non-secret ID from the key. Allowed: 1-64 letters, digits, underscore, hyphen.
SDK_IDEMPOTENCY_MASTER_KEY_ID=
# JSON object mapping prior key IDs to their 64-hex keys. During rotation, move
# the old active key here and retain it for at least the full seven-day record
# TTL (plus deployment overlap) before deletion. Example shape only:
# {"old_id":"<64-hex>"}
SDK_IDEMPOTENCY_PREVIOUS_KEYS_JSON=

# SMTP Credentials (optional, e.g. Namecheap Private Email: mail.privateemail.com)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Production always validates Twilio signatures even if this flag is false.
TWILIO_VALIDATE_WEBHOOKS=true
# Canonical HTTPS URL configured in Twilio; avoids proxy-host ambiguity.
TWILIO_INBOUND_WEBHOOK_URL=https://api.nexid.lat/twilio/whatsapp/inbound
# Preview/local test automation only. It is ignored in production and must not
# reuse ADMIN_API_KEY or any signing/KMS credential.
TWILIO_INTERNAL_WEBHOOK_KEY=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Clerk verification for founder/admin sync and the verified Web3 bridge.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless Clerk JWT verification.
CLERK_JWT_KEY=
# Comma-separated exact web/dashboard origins accepted in Clerk token `azp`.
# Required in production by Clerk-authenticated API bridges.
CLERK_AUTHORIZED_PARTIES=https://app.nexid.lat,https://nexid.lat
DASHBOARD_CLERK_SUPERADMIN_EMAIL_ALLOWLIST=guillen.marce@gmail.com

# Trust maps: post-tap mobile passport and public proof pages.
# Use a free raster fallback for demos, or point this to your own tile server.
NEXID_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXID_DARK_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Optional operator-controlled raster override. Leave unset for OpenFreeMap vector styles.
# NEXID_RASTER_TILE_TEMPLATE=https://maps.example.com/{z}/{x}/{y}.png
NEXID_PMTILES_URL=
NEXID_MAP_ATTRIBUTION=OpenFreeMap © OpenMapTiles · Data from OpenStreetMap

# Polygon Amoy: ownership certificates, warranty and transferable claims.
# Current Polygon docs list third-party Amoy faucets; QuickNode/Alchemy are the practical options.
TOKENIZATION_MODE=off
TOKENIZATION_USE_LOCAL_MINTER=false
# Global auto-mint gate. Tenant/batch explicit policy + opt-in are also required.
SUN_AUTO_TOKENIZE_ON_VALID_TAP=false
TOKENIZATION_UID_SALT=
TOKENIZATION_METADATA_CID_PREFIX=ipfs://
TOKENIZATION_METADATA_BASE_URL=https://api.nexid.lat/public/polygon/assets
PUBLIC_POLYGON_METADATA_BASE_URL=https://api.nexid.lat/public/polygon/metadata
PUBLIC_PROOF_DEMO_POLYGON_TOKEN_ID=
PUBLIC_PROOF_DEMO_POLYGON_TX_HASH=
PUBLIC_PROOF_DEMO_POLYGON_CLAIM_TX_HASH=
PUBLIC_PROOF_DEMO_POLYGON_BUYER_ADDRESS=
PUBLIC_PROOF_DEMO_POLYGON_WALLET_SIGNATURE=
# Local testnet custody only. Never upload this demo buyer key to Vercel or use it on mainnet.
PUBLIC_PROOF_DEMO_POLYGON_BUYER_PRIVATE_KEY=
PUBLIC_PROOF_DEMO_POLYGON_BUYER_FUNDING_TX_HASH=
PUBLIC_PROOF_DEMO_POLYGON_SOURCE_VERIFIED=false
POLYGON_RPC_URL=https://polygon-amoy.drpc.org
POLYGON_DEPLOY_OWNER=
POLYGON_MINTER_ADDRESS=
POLYGON_MINTER_PRIVATE_KEY=
POLYGON_CONTRACT_ADDRESS=
TOKENIZATION_EXECUTOR_URL=
# Dedicated API-to-executor HTTP credential, minimum 32 random bytes.
TOKENIZATION_EXECUTOR_SECRET=
# Dedicated worker credential, minimum 32 random bytes in production.
INTERNAL_TOKENIZATION_KEY=

# IOTA EVM Testnet: V2 hash-only proof anchors. New writes are V2-only.
# Testnets can reset; use this for sales/technical demos, not legal production evidence.
IOTA_PROVIDER_MODE=disabled
IOTA_EVM_RPC_URL=https://json-rpc.evm.testnet.iota.cafe
IOTA_EVM_EXPECTED_CHAIN_ID=1076
IOTA_EVM_MIN_CONFIRMATIONS=1
IOTA_EVM_ANCHOR_CONTRACT_VERSION_V2=evidence_anchor_v2
# Production/API custody: use the isolated executor and keep the private key out of Next.js.
IOTA_PROOF_EXECUTOR_URL=
IOTA_PROOF_EXECUTOR_SECRET=
INTERNAL_PROOF_ANCHOR_KEY=
# Required for POST /sun/simulate. The route fails closed when absent.
SUN_SIMULATE_API_KEY=
# Local testnet development only; ignored unless IOTA_ALLOW_LOCAL_SIGNER=true and NODE_ENV is not production.
IOTA_ALLOW_LOCAL_SIGNER=false
IOTA_EVM_PRIVATE_KEY=
IOTA_ALLOW_DIRECT_EVENT_HASHES=false
# Public read-only fixture. A signer is not required to verify these transactions.
IOTA_EVM_DEPLOYER_ADDRESS=0x2f320d2B0D8AE483637D8f5509480228509165cB
IOTA_EVM_ANCHOR_CONTRACT_V2=0xde7284812D0c81080Cc7B2f60d6D9769343Aa2B0
PUBLIC_PROOF_DEMO_IOTA_V2_TX_HASH_SECURE_DELIVERY=0xdb59a61427fd9ffef0e9c1112fed76ea71053cffab684fc6888a00abf748d8a8
PUBLIC_PROOF_DEMO_IOTA_V2_TX_HASH_PHARMA_COLD_CHAIN=0x4b33d013d81596aea6bc7611400fe7a77fcc1dc98a1d190aa21cb4a38036c079
PUBLIC_PROOF_DEMO_IOTA_V2_TX_HASH_AGRO_STEWARDSHIP=0x1af34ec919d14ef46cd14723d00d4d2eabe3699d0dbe4d1533b2dc1ef0e205d0
IOTA_EXPLORER_BASE_URL=https://explorer.evm.testnet.iota.cafe
# Legacy V1 contract/transactions remain optional for historical fixtures.
IOTA_EVM_ANCHOR_CONTRACT=
PUBLIC_PROOF_DEMO_IOTA_TX_HASH=
PUBLIC_PROOF_DEMO_IOTA_TX_HASH_SECURE_DELIVERY=
PUBLIC_PROOF_DEMO_IOTA_TX_HASH_PHARMA_COLD_CHAIN=
PUBLIC_PROOF_DEMO_IOTA_TX_HASH_AGRO_STEWARDSHIP=
PUBLIC_PROOF_RECEIPT_IOTA_TX_HASH=
PUBLIC_PROOF_RECEIPT_IOTA_TX_HASH_SECURE_DELIVERY=
PUBLIC_PROOF_RECEIPT_IOTA_TX_HASH_PHARMA_COLD_CHAIN=
PUBLIC_PROOF_RECEIPT_IOTA_TX_HASH_AGRO_STEWARDSHIP=

# Activate only after 0117 and compatible API/dashboard readers are verified.
SUPPLIER_REQUEST_CANCELLATION_ENABLED=false

# Enable only after migration 0118, compatible readers, and reviewed role/tenant checks.
# Turning writes off preserves the read-only history endpoint.
SUPPLIER_REQUEST_QUOTES_ENABLED=false
