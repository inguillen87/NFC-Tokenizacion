{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3003",
    "prebuild": "npm run prisma:generate",
    "build": "node scripts/sanitize-route-tree.mjs && npm run test:routes && npm run test:rewards && npm run test:polygon-transfer && npm run test:wallet-control && next build",
    "start": "next start -p 3003",
    "db:new": "node scripts/db-new-migration.mjs",
    "db:migrate": "node scripts/db-apply.mjs",
    "db:seed": "node scripts/db-seed-dev.mjs",
    "db:reset:local": "node scripts/db-reset-local.mjs",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.mjs",
    "demo:demobodega": "node scripts/demo-demobodega.mjs",
    "demo:seed": "node scripts/demo-demobodega.mjs",
    "demo:reset": "node scripts/demo-reset-demobodega.mjs",
    "demo:emit-taps": "node scripts/demo-emit-taps.mjs",
    "test:loyalty": "node --test tests/loyalty-rules.test.mjs",
    "tokenization:check": "node scripts/check-tokenization-readiness.mjs",
    "amoy:watch-balance": "node scripts/watch-amoy-balance.mjs",
    "contracts:compile": "hardhat compile",
    "contracts:test:iota": "hardhat run scripts/test-iota-anchor-v2.mjs",
    "contracts:deploy:amoy": "hardhat run scripts/deploy-nexid-amoy.mjs --network amoy",
    "contracts:deploy:iota-testnet": "hardhat run scripts/deploy-iota-anchor.mjs --network iotaevm-testnet",
    "testnet:wallets": "node scripts/setup-testnet-wallets.mjs",
    "iota:l1:faucet": "node scripts/setup-iota-l1-faucet.mjs",
    "iota:bridge:evm": "node scripts/bridge-iota-l1-to-evm.mjs",
    "iota:publish-proof-receipts": "node scripts/publish-public-proof-receipts-iota.mjs",
    "iota:verify-proof-v2": "node scripts/verify-public-proof-iota-v2.mjs",
    "bootstrap:tenant": "node scripts/bootstrap-enterprise-tenant.mjs",
    "test:consumer": "node --test tests/consumer-portal-rules.test.mjs",
    "test:rewards": "node --test tests/reward-public-links-security.test.mjs",
    "test:sun": "node --test tests/sun-*.test.mjs",
    "test:routes": "node scripts/sanitize-route-tree.mjs && node --test tests/app-route-slug-conflicts.test.mjs",
    "test:demo-corpus": "node --test tests/demo-corpus-smoke.test.mjs",
    "test:proof-demos": "node --import tsx --test tests/public-proof-demo-cases.test.mjs tests/public-polygon-ownership.test.mjs",
    "test:polygon-transfer": "node --import tsx --test tests/polygon-transfer-integrity.test.mjs tests/tokenization-runtime-truth.test.mjs tests/admin-tokenization-tenant-isolation.test.mjs",
    "test:wallet-control": "node --import tsx --test tests/wallet-control.test.mjs tests/public-certificate-contract.test.mjs",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "bootstrap:saas": "node scripts/bootstrap-saas.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@openzeppelin/contracts": "^5.1.0",
    "@prisma/client": "^5.22.0",
    "@product/core": "file:../../packages/core",
    "csv-parse": "^5.6.0",
    "ethers": "^6.17.0",
    "next": "^16.2.9",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "twilio": "^6.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@iota/iota-sdk": "^1.15.0",
    "@nomicfoundation/hardhat-ethers": "^4.0.13",
    "@nomicfoundation/hardhat-verify": "^3.0.21",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "hardhat": "^3.9.0",
    "pg": "^8.22.0",
    "prisma": "^5.22.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
