# Destructive E2E harness: copy these values into the invoking shell only.
# The script intentionally does not load apps/api/.env.local.
E2E_TARGET=local
E2E_ALLOW_MUTATION=I_UNDERSTAND_NEXID_E2E_MUTATES_TEST_DATA
E2E_API_BASE=http://127.0.0.1:3000
E2E_DATABASE_URL=postgresql://nexid:replace-me@localhost:5432/nexid_e2e
E2E_DATABASE_HOST_ALLOWLIST=localhost
E2E_ADMIN_SESSION_TOKEN=replace-with-local-e2e-admin-session-token

# The target API must be non-production and may expose test OTPs only when both
# NODE_ENV/VERCEL_ENV are non-production and this flag is explicitly enabled.
# CONSUMER_AUTH_DEBUG_CODE_RESPONSE=true
