{
  "name": "product-identity-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "dev:api": "npm run dev --workspace=api",
    "dev:executor": "npm run dev --workspace=executor",
    "build:web": "npm run qa:static && npm run build --workspace=web",
    "build:dashboard": "npm run qa:static && npm run build --workspace=dashboard",
    "build:api": "npm run verify:routes && npm run build --workspace=api",
    "typecheck:dashboard": "npm run typecheck --workspace=dashboard",
    "build": "npm run build --workspaces --if-present",
    "db:new": "npm run db:new --workspace=api --",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "db:reset:local": "npm run db:reset:local --workspace=api",
    "demo:demobodega": "npm run demo:demobodega --workspace=api",
    "demo:seed": "npm run demo:seed --workspace=api",
    "demo:reset": "npm run demo:reset --workspace=api",
    "demo:emit-taps": "npm run demo:emit-taps --workspace=api",
    "tenant-admin:credentials": "npm run tenant-admin:credentials --workspace=api --",
    "check:routes": "node scripts/check-next-dynamic-routes.mjs",
    "verify:routes": "npm run check:routes && npm run test:routes --workspace=api",
    "check:placeholders": "node scripts/check-no-placeholders.mjs",
    "check:secrets": "node scripts/check-no-tracked-secrets.mjs",
    "demo:smoke": "npm run demo:smoke --workspace=api",
    "executor:check": "npm run check --workspace=executor",
    "qa:static": "node scripts/qa-static.mjs",
    "pilot:check": "node scripts/pilot-check.mjs",
    "pilot:check:full": "node scripts/pilot-check.mjs --full",
    "gate:postgres:staging": "node scripts/staging-postgres-smoke.mjs",
    "gate:migrations:preflight": "node scripts/staging-migration-preflight.mjs",
    "gate:migrations:dry-run": "node scripts/staging-migration-dry-run.mjs",
    "gate:migrations:postcheck": "node scripts/staging-postgres-smoke.mjs",
    "gate:migrations:rollback-verify": "node scripts/staging-migration-rollback-verify.mjs",
    "check:migrations:safety": "node scripts/check-migration-safety.mjs",
    "test:migration-gates": "node --test scripts/tests/staging-migration-gates.test.mjs scripts/tests/enterprise-staging-workflow.test.mjs",
    "test:security-gates": "node --test scripts/tests/secret-custody-gate.test.mjs",
    "test:e2e:ephemeral:safety": "npm run test:e2e:ephemeral:safety --workspace=api",
    "test:e2e:ephemeral": "npm run test:e2e:ephemeral --workspace=api",
    "supplier:physical-evidence:validate": "npm run supplier:physical-evidence:validate --workspace=api --",
    "evidence:syngenta:screenshots": "node scripts/validate-syngenta-screenshot-evidence.mjs",
    "evidence:sun-location:validate": "node scripts/validate-sun-location-physical-certification.mjs",
    "test:sun-location-certification": "node --test scripts/tests/sun-location-physical-certification.test.mjs",
    "apply:staging:v2": "node scripts/apply-staging-v2-migrations.mjs",
    "check:waf:policy": "node scripts/validate-waf-policy.mjs",
    "gate:iota:readonly": "node scripts/iota-v2-readonly-smoke.mjs",
    "gate:iota:live-canary": "node scripts/iota-staging-live-canary.mjs",
    "gate:enterprise": "node scripts/enterprise-gates.mjs"
  },
  "packageManager": "npm@10.9.0",
  "devDependencies": {
    "postcss": "8.5.23"
  },
  "optionalDependencies": {
    "sharp": "0.35.4"
  },
  "overrides": {
    "gcp-metadata": "8.1.2",
    "google-gax": "5.0.4",
    "postcss": "$postcss",
    "sharp": "$sharp",
    "three": "0.184.0",
    "next": {
      ".": "16.3.6",
      "postcss": "$postcss",
      "sharp": "$sharp"
    },
    "nanoid": "3.3.18",
    "adm-zip": "0.6.1",
    "qs": "6.16.0"
  },
  "engines": {
    "node": ">=20.11.1"
  }
}
